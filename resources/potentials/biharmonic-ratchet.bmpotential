{
  "format": "brownian-motor-potential",
  "format_version": 1,

  "id": "biharmonic-ratchet",
  "name": "Biharmonic ratchet",
  "description": "Periodic asymmetric potential with two spatial harmonics.",

  "coordinate": {
    "symbol": "x",
    "unit": "dimensionless"
  },

  "profile": {
    "expression":
      "V1 * sin(2 * pi * x) + V2 * sin(4 * pi * x)",

    "derivative_expression":
      "2 * pi * V1 * cos(2 * pi * x) + 4 * pi * V2 * cos(4 * pi * x)",

    "periodic": true,
    "period": 1.0
  },

  "parameters": [
    {
      "id": "V1",
      "label": "V₁",
      "description": "Amplitude of the first spatial harmonic.",
      "unit": "dimensionless",

      "default": 0.20,
      "minimum": -100.0,
      "maximum": 100.0,
      "step": 0.01,
      "decimals": 8
    },
    {
      "id": "V2",
      "label": "V₂",
      "description": "Amplitude of the second spatial harmonic.",
      "unit": "dimensionless",

      "default": 0.10,
      "minimum": -100.0,
      "maximum": 100.0,
      "step": 0.01,
      "decimals": 8
    }
  ]
}